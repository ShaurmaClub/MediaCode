# МедиаКод — Конфигурация окружения
# Скопируйте данный файл в .env перед локальным запуском: cp .env.example .env
# На сервере файл создаётся автоматически в /var/lib/mediacode/<env>/.env при запуске deploy/install.sh

# Режим работы (development | production | test)
NODE_ENV=development
DEPLOY_ENV=development

# Сетевой интерфейс и порт Express API (в production: 127.0.0.1)
HOST=127.0.0.1
PORT=4000

# Публичный URL приложения (используется для строгой проверки Origin)
PUBLIC_ORIGIN=http://localhost:5173

# Секретный ключ подписи сессий (в production обязателен, минимум 32 символа: openssl rand -hex 32)
SESSION_SECRET=change-me-generate-random-string-of-64-chars

# Пути к персистентным данным
DB_PATH=./data/media.db
UPLOAD_DIR=./uploads/recruitment
UPLOADS_DIR=./uploads/recruitment
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# Лимиты запросов (защита от перебора и спама)
TRUST_PROXY=1
RATE_LIMIT_MAX=250
AUTH_RATE_LIMIT_MAX=30
PUBLIC_RECRUIT_RATE_LIMIT_MAX=20

# Внешнее зашифрованное хранилище резервных копий (restic, опционально)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Уведомления мониторинга и резервного копирования (Telegram / Webhook, опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
ALERT_WEBHOOK_URL=

# Опциональный URL политики конфиденциальности
PRIVACY_POLICY_URL=

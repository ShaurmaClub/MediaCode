# МедиаКод — Конфигурация окружения
# Скопируйте данный файл в .env перед запуском: cp .env.example .env

# Порт Express API бэкенда
PORT=4000

# Режим работы (development | production)
NODE_ENV=development

# Путь к файлу базы данных SQLite
DB_PATH=./data/media.db

# Секретный ключ для подписи сессий Express (замените на надёжную случайную строку в проде)
SESSION_SECRET=change-me-generate-random-string-of-64-chars

# Опциональный токен Telegram/MAX бота для интеграций
MAX_BOT_TOKEN=

# URL для ссылки на согласие на обработку персональных данных (по умолчанию модальное окно)
PRIVACY_POLICY_URL=

# Автоматические резервные копии БД (npm run backup делает копию вручную)
# AUTO_BACKUP=1
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# BACKUP_DIR=./data/backups

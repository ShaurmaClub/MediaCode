[Unit]
Description=MediaCode Production Server (kaiton.ru)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/mediacode
EnvironmentFile=/var/www/mediacode/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /var/www/mediacode/server/index.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

# Безопасность процесса (Ubuntu 24.04 systemd hardening)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mediacode-prod

[Install]
WantedBy=multi-user.target
